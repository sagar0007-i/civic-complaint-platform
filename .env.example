# ==============================================================================
# CivicPulse Environment Configuration
# ==============================================================================

# Application
APP_NAME=CivicPulse
APP_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production_32chars_min

# Database
# Default: SQLite for immediate local dev/testing without external DB setup.
# Production / Docker: postgresql+psycopg://civic_user:civic_pass@localhost:5432/civic_db
DATABASE_URL=sqlite:///./civic_pulse.db

# Storage Configuration
# Options: local, s3, r2, supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# S3 / R2 / Supabase Storage (for cloud production storage)
S3_BUCKET=civic-pulse-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# AI Configuration
# Options: mock, heuristic, gemini, openai
AI_PROVIDER=heuristic
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maps & Geolocation
# Options: osm, mapbox, google_maps
MAP_PROVIDER=osm
MAP_API_KEY=
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_CITY=Bengaluru
DEFAULT_STATE=Karnataka

# Notification Channels
ENABLE_IN_APP_NOTIFICATIONS=True
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SMS_NOTIFICATIONS=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@civicpulse.gov.in

# SLA & Escalation
SLA_CHECK_INTERVAL_MINUTES=15
AUTO_ESCALATION_ENABLED=True
